# ===================================================
# Iniyal's Bake House - Environment Configuration Example
# ===================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/iniyals_bakehouse?retryWrites=true&w=majority

# Security & Session
JWT_SECRET=replace_with_secure_random_secret

# Initial Administrator Setup
ADMIN_EMAIL=your_admin_email@domain.com
ADMIN_PASSWORD=your_secure_admin_password
