# ===================================================
# Iniyal's Bake House - Environment Configuration Example
# ===================================================

# Server Environment
NODE_ENV=production
PORT=5000

# Security & Session
# Generate a secure random string (e.g., using: openssl rand -base64 32)
JWT_SECRET=replace_with_secure_random_secret

# Initial Administrator Setup
# Note: Used to initialize the first admin account if the database is newly created.
ADMIN_EMAIL=your_admin_email@domain.com
ADMIN_PASSWORD=your_secure_admin_password

# Persistent Storage Overrides (Optional - for platforms with mounted volumes)
# DB_PATH=/var/data/bakehouse.db
# UPLOADS_DIR=/var/data/uploads
